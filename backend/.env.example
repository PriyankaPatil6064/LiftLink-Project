# ─────────────────────────────────────────────────────────────────────────────
# LiftLink Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/liftlink?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────────────────────────
# JWT secret — use a strong random string (minimum 32 characters)
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_very_long_random_secret_min_32_characters

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# Node environment: development | production
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Production example: https://liftlink.vercel.app
# Development: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ─── Email (Nodemailer / Gmail SMTP) ─────────────────────────────────────────
# Gmail address used as the "from" address for all system emails
EMAIL_FROM=your-gmail@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Generate at: Google Account → Security → App Passwords
EMAIL_PASSWORD=your_16_char_app_password

# ─── Frontend URL ─────────────────────────────────────────────────────────────
# Used in email templates for links (no trailing slash)
# Development: http://localhost:3000
# Production: https://liftlink.vercel.app
CLIENT_URL=http://localhost:3000

# ─── Notes ────────────────────────────────────────────────────────────────────
# For production, use SendGrid or AWS SES instead of Gmail SMTP:
# - SENDGRID_API_KEY=your_sendgrid_key
# Cloudinary (optional — currently using local disk storage via multer):
# - CLOUDINARY_CLOUD_NAME=your_cloud_name
# - CLOUDINARY_API_KEY=your_api_key
# - CLOUDINARY_API_SECRET=your_api_secret
